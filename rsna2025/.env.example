# ==============================================================================
# RSNA 2025 Intracranial Aneurysm Detection - 1st Place Solution (tomoon33)
# Environment Configuration (.env)
# ==============================================================================

# Project root and configurations
PROJECT_ROOT="."
CONFIG_DIR="./configs"

# nnU-Net Standard Directories
nnUNet_raw="./data/nnUNet/raw"
nnUNet_preprocessed="./data/nnUNet/preprocessed"
nnUNet_results="./logs/nnUNet_results"

# Execution device (cuda:0 uses NVIDIA RTX 5070 Ti)
VESSEL_DEVICE="cuda:0"
VESSEL_DEVICES="0"

# Safeguards / Fallbacks on detection anomalies
VESSEL_ABORT_ON_SPARSE_FAIL="1"
VESSEL_ABORT_MIN_ALL_DIMS_MM="140"
VESSEL_ABORT_ON_SMALL_ROI="0"
VESSEL_MIN_ROI_VOXELS="100000"
VESSEL_ABORT_ON_LOW_UNION="1"
VESSEL_MIN_UNION_SUM="5000"
RSNA_ERROR_FALLBACK_PROBS="0.02,0.02,0.08,0.08,0.03,0.03,0.07,0.02,0.02,0.02,0.02,0.02,0.02,0.35"

# 1. Coarse Vessel Segmentation & ROI Search (Dataset003 Vessel Grouping)
VESSEL_NNUNET_SPARSE_MODEL_DIR="./logs/nnUNet_results/Dataset003_VesselGrouping/RSNA2025Trainer_moreDAv7__nnUNetResEncUNetMPlans__3d_fullres"
VESSEL_ENABLE_ORIENTATION_CORRECTION="1"
VESSEL_ORIENTATION_WEIGHTS="1,1,1"
VESSEL_SPARSE_ROI_EXTENT_MM="140"
VESSEL_REFINE_Z_ONLY="0"
VESSEL_SPARSE_OVERLAP="0.2"

# 2. Fine Vessel Segmentation (Dataset001 Vessel Segmentation)
VESSEL_NNUNET_MODEL_DIR="./logs/nnUNet_results/Dataset001_VesselSegmentation/nnUNetTrainerSkeletonRecall_more_DAv3_ep800__nnUNetResEncUNetMPlans__3d_fullres"
VESSEL_ADDITIONAL_DENSE_MODEL_DIRS="./logs/nnUNet_results/Dataset001_VesselSegmentation/RSNA2025Trainer_moreDAv6_SkeletonRecallW3TverskyBeta07__nnUNetResEncUNetMPlans__3d_fullres"
VESSEL_FOLDS="all"
VESSEL_DENSE_OVERLAP="0.3"
VESSEL_REFINE_MARGIN_Z="15"
VESSEL_REFINE_MARGIN_XY="30"

# 3. ROI Multi-label Classification Model (Hydra Experiment)
ROI_EXPERIMENTS="251013-seg_tf-v4-nnunet_truncate1_preV6_1-ex_dav6w3-m32g64-e25-w01_005_1-s128_256_256"
ROI_FOLDS="0,1,2,3"
ROI_TTA="2"
ROI_NNUNET_MODEL_DIR="./logs/nnUNet_results/Dataset001_VesselSegmentation/RSNA2025Trainer_moreDAv6_1_SkeletonRecallTverskyBeta07__nnUNetResEncUNetMPlans__3d_fullres"

# Operational switches
RUN_MODE="kaggle"
RSNA_ONLY_AP="0"
RSNA_ONLY_LOCATIONS="0"
RSNA_MAX_PREDICT_ERRORS="300"
RSNA_DEBUG="1"
